# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to ".env" and fill in real values. NEVER commit your .env file.
# ─────────────────────────────────────────────────────────────────────────────

# Environment: "development" or "production".
# In production the app refuses to start unless SESSION_SECRET is set and strong,
# and it enables secure cookies + HSTS (assumes it sits behind HTTPS / a proxy).
NODE_ENV=development

# Port the HTTP server listens on.
PORT=3000

# Absolute or relative path to the SQLite database file.
# Defaults to "<project root>/data/portfolio.db" if left unset.
# When you migrate to AWS, point this at an EFS mount or swap the repository layer
# for an RDS-backed implementation (see README "Path to AWS").
DATABASE_PATH=

# Secret used to sign session cookies. Generate a long random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Required (and must be >= 32 chars) when NODE_ENV=production.
SESSION_SECRET=change-me-in-production-use-a-48-byte-random-string

# Set to "true" when the app runs behind a reverse proxy / load balancer that
# terminates TLS (nginx, ALB, Cloudflare). Enables "trust proxy" so secure
# cookies and rate limiting work correctly.
TRUST_PROXY=false

# ── Initial admin account (used ONLY by `npm run seed`) ──────────────────────
# If these are omitted during seeding, a strong random password is generated and
# printed to the console exactly once. Change the password from the admin panel
# after first login regardless.
ADMIN_USERNAME=nathan
ADMIN_PASSWORD=

# ─────────────────────────────────────────────────────────────────────────────
# "Interview my AI self" feature
# Leave everything below unset to run the feature in safe local mode: a no-cost
# stub model + console email (links printed to the terminal), so the whole
# request → approve → interview flow works without any keys or spend.
# ─────────────────────────────────────────────────────────────────────────────

# Master on/off switch for the whole feature.
INTERVIEW_ENABLED=true

# Absolute public origin, used to build links inside emails AND for SEO
# (canonical URLs, sitemap, Open Graph). In production this MUST be set to your
# real https URL (the app refuses to boot otherwise). Locally it defaults to
# http://localhost:PORT.
APP_BASE_URL=

# Inbox that receives approval requests (you). Approve/decline happens here.
INTERVIEW_APPROVER_EMAIL=you@example.com

# ── LLM provider ──
# 'anthropic' uses Claude; 'stub' is the free offline placeholder. If left blank,
# the app uses 'anthropic' when ANTHROPIC_API_KEY is set, else 'stub'.
LLM_PROVIDER=
# Claude API key. SERVER-ONLY — never commit it, never expose it client-side.
# In production inject it from AWS SSM Parameter Store / Secrets Manager at
# runtime (see DEPLOY.md), NOT from a committed file.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5
LLM_MAX_TOKENS=400

# ── Cost caps (every limit is a backstop; tune as needed) ──
INTERVIEW_MAX_TURNS=12              # questions allowed per interview
INTERVIEW_HISTORY_TURNS=8           # turn-pairs of history sent to the model
INTERVIEW_SESSION_TTL_HOURS=48      # how long an interview link stays usable
INTERVIEW_APPROVAL_TTL_HOURS=168    # how long an approval link stays valid
INTERVIEW_MAX_INPUT_CHARS=1500      # max characters per question
INTERVIEW_DAILY_REQUEST_CAP=50      # access requests accepted per day
INTERVIEW_DAILY_SESSION_CAP=10      # interviews approved per day
INTERVIEW_DAILY_TOKEN_CAP=150000    # hard global token ceiling per day

# ─────────────────────────────────────────────────────────────────────────────
# AI engineering showcase (/lab, guardrails, model router)
# Every default below adds ZERO extra LLM spend. The only settings that can add
# cost are LLM_ROUTER=true and LLM_ROUTER_CLASSIFIER=llm — both explicit opt-ins.
# ─────────────────────────────────────────────────────────────────────────────

# Public /lab observability dashboard + /lab/red-team report. Free: reads
# committed eval-run files and the local traces table. Set false to hide both.
LAB_ENABLED=true

# Deterministic guardrails (prompt-injection / PII / scope patterns) that run
# BEFORE any model call. Blocked turns never reach the LLM, so attacks cost $0.
GUARDRAILS_ENABLED=true

# Haiku→Sonnet model router. OFF by default: escalated turns bill at Sonnet
# rates. Turning this on is the only way chat spend can rise above LLM_MODEL.
LLM_ROUTER=false
# Escalation model used only when LLM_ROUTER=true.
LLM_MODEL_STANDARD=claude-sonnet-4-6
# 'heuristic' (default) classifies difficulty for free. 'llm' adds one cheap
# classifier call PER MESSAGE and requires LLM_ROUTER=true — costs real money.
LLM_ROUTER_CLASSIFIER=heuristic

# ── Email transport ──
# 'console' prints emails to the terminal (dev). 'ses' sends via AWS SES.
EMAIL_TRANSPORT=console
# SES sender (must be a verified identity) and region. AWS credentials are
# resolved from the instance/container IAM role — no AWS secret goes here.
SES_FROM_EMAIL=
SES_REGION=us-east-1
