<%- include('../partials/head', { nav: 'public', bodyClass: 'page-home' }) %>

<section class="hero">
  <%- include('../partials/hero-visual') %>
  <div class="hero__inner">
    <p class="eyebrow animate-rise">
      <span class="eyebrow__index">§00</span>
      <span class="eyebrow__label">Portfolio</span>
      <% if (profile.location) { %><span class="eyebrow__sep">/</span><span><%= profile.location %></span><% } %>
    </p>

    <h1 class="hero__title animate-rise"><%= profile.headline %></h1>

    <% const leadParagraph = (profile.bio || '').split('\n\n')[0]; %>
    <% if (leadParagraph) { %>
      <p class="hero__lead animate-rise"><%= leadParagraph %></p>
    <% } %>

    <div class="hero__actions animate-rise">
      <a href="#work" class="btn btn--accent">Selected work</a>
      <% if (profile.email) { %>
        <a href="mailto:<%= profile.email %>" class="btn btn--ghost">Get in touch</a>
      <% } %>
      <% if (profile.linkedinUrl) { %>
        <a href="<%= profile.linkedinUrl %>" target="_blank" rel="noopener noreferrer" class="btn btn--ghost">LinkedIn ↗</a>
      <% } %>
    </div>

    <dl class="hero__stats animate-rise">
      <div class="stat">
        <dt class="stat__label">Projects</dt>
        <dd class="stat__value"><%= String(totalProjects).padStart(2, '0') %></dd>
      </div>
      <div class="stat">
        <dt class="stat__label">Focus</dt>
        <dd class="stat__value stat__value--text">Embedded · Web · Cloud</dd>
      </div>
      <div class="stat">
        <dt class="stat__label">Based in</dt>
        <dd class="stat__value stat__value--text"><%= profile.location || '—' %></dd>
      </div>
    </dl>
  </div>
  <div class="hero__ticks" aria-hidden="true">
    <span></span><span></span><span></span><span></span>
  </div>
</section>

<% if (proofTiles) { %>
<section class="section" id="ai">
  <div class="lab-teaser">
    <div>
      <p class="eyebrow reveal">
        <span class="eyebrow__index">§AI</span>
        <span class="eyebrow__label">The live demo</span>
      </p>
      <h2 class="lab-teaser__title reveal" data-delay="1">Don't read my CV — <em>interview</em> it.</h2>
      <p class="lab-teaser__lead reveal" data-delay="2">
        A gated AI version of me answers real interview questions, grounded in the same data
        that renders this site — evaluated, guardrailed, traced, and cost-capped. The
        engineering is public: every metric links to the lab.
      </p>
      <div class="hero__actions reveal" data-delay="3">
        <a href="/interview" class="btn btn--accent">Request an interview <span class="btn__arrow" aria-hidden="true">→</span></a>
        <a href="/lab" class="btn btn--ghost">Explore the lab</a>
      </div>
    </div>
    <div class="reveal" data-delay="2">
      <%- include('../partials/proof-strip', { tiles: proofTiles }) %>
    </div>
  </div>
</section>
<% } %>

<section class="section" id="work">
  <header class="section__head reveal">
    <h2 class="section__title"><span class="section__index">§01</span> Selected work</h2>
    <a href="/projects" class="section__action">All projects <span aria-hidden="true">→</span></a>
  </header>

  <% if (selectedProjects.length === 0) { %>
    <p class="empty">No projects published yet.</p>
  <% } else { %>
    <div class="project-grid">
      <% selectedProjects.forEach(function (project, index) { %>
        <%- include('../partials/project-card', { project: project, index: index }) %>
      <% }); %>
    </div>
  <% } %>
</section>

<section class="section section--split" id="about">
  <header class="section__head reveal">
    <h2 class="section__title"><span class="section__index">§02</span> About</h2>
  </header>
  <% if (profile.bio) { %>
    <% const firstSentence = profile.bio.split(/(?<=[.!?])\s+/)[0]; %>
    <blockquote class="pullquote reveal" data-pullquote><%= firstSentence %></blockquote>
  <% } %>
  <div class="prose prose--lead reveal" data-delay="1">
    <% if (profile.bio) { %>
      <%- helpers.paragraphsHtml(profile.bio) %>
    <% } else { %>
      <p class="empty">No bio yet.</p>
    <% } %>
  </div>
</section>

<% if (work.length > 0) { %>
<section class="section" id="experience">
  <header class="section__head reveal">
    <h2 class="section__title"><span class="section__index">§03</span> Experience</h2>
  </header>
  <%- include('../partials/timeline', { items: work }) %>
</section>
<% } %>

<% if (education.length > 0) { %>
<section class="section" id="education">
  <header class="section__head reveal">
    <h2 class="section__title"><span class="section__index">§04</span> Education</h2>
  </header>
  <%- include('../partials/timeline', { items: education }) %>
</section>
<% } %>

<% if (certifications.length > 0) { %>
<section class="section" id="certifications">
  <header class="section__head reveal">
    <h2 class="section__title"><span class="section__index">§05</span> Certifications</h2>
  </header>
  <%- include('../partials/timeline', { items: certifications }) %>
</section>
<% } %>

<% if (skillGroups.length > 0) { %>
<section class="section" id="skills">
  <header class="section__head reveal">
    <h2 class="section__title"><span class="section__index">§06</span> Capabilities</h2>
  </header>
  <%# Motion-capable visitors get an infinite mono ticker per group
      (duplicate row is decoration); everyone else gets the plain grid. %>
  <div class="skills-grid">
    <% skillGroups.forEach(function (group, gi) { %>
      <div class="skill-group reveal" <% if (gi < 5) { %>data-delay="<%= Math.min(gi + 1, 5) %>"<% } %>>
        <h3 class="skill-group__title"><%= group.category %></h3>
        <div class="ticker <%= gi % 2 ? 'ticker--reverse' : '' %>">
          <ul class="tag-list ticker__row">
            <% group.skills.forEach(function (skill) { %>
              <li class="tag"><%= skill.name %></li>
            <% }); %>
          </ul>
          <ul class="tag-list ticker__row ticker__row--dup" aria-hidden="true">
            <% group.skills.forEach(function (skill) { %>
              <li class="tag"><%= skill.name %></li>
            <% }); %>
          </ul>
        </div>
      </div>
    <% }); %>
  </div>
</section>
<% } %>

<%- include('../partials/footer') %>
