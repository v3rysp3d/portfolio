<%- include('../../partials/head', { nav: 'none', bodyClass: 'page-interview' }) %>

<%
  const reasons = {
    disabled: ['Interview unavailable', 'The AI interview is currently switched off. Please check back later.'],
    capacity: ['At capacity for today', 'The interview has hit its daily limit. Please try requesting access again tomorrow.'],
    invalid:  ['Link not valid', 'This interview link is invalid. Request access again to get a fresh one.'],
    expired:  ['Link expired', 'This interview link has expired. Request access again to get a new one.'],
    revoked:  ['Interview ended', 'This interview session is no longer active.'],
    limit:    ['Question limit reached', 'You have used all your questions for this interview. Thanks for your time!'],
  };
  const r = reasons[reason] || reasons.invalid;
%>

<section class="auth">
  <div class="auth__card animate-rise">
    <a href="/" class="auth__brand" aria-label="Home">
      <span class="monogram__mark"><%= helpers.initials(profile.name) %></span>
    </a>
    <h1 class="auth__title"><%= r[0] %></h1>
    <p class="auth__subtitle"><%= r[1] %></p>
    <a href="/interview" class="btn btn--accent btn--block">Request access</a>
    <a href="/" class="auth__back">← Back to site</a>
  </div>
</section>

<%- include('../../partials/footer') %>
