<%- include('../../partials/head', { nav: 'public', bodyClass: 'page-lab' }) %>

<%
  const t = lab.telemetry;
  const run = lab.latestRun;
  const fmtPct = (n) => n === null || n === undefined ? '—' : `${(n * 100).toFixed(1)}%`;
  const fmtMs = (n) => n === null ? '—' : (n >= 1000 ? `${(n / 1000).toFixed(1)}s` : `${n}ms`);
  const fmtUsd = (n) => n === null ? '—' : `$${n.toFixed(4)}`;
%>

<section class="section section--top">
  <p class="eyebrow reveal">
    <span class="eyebrow__index">§LAB</span>
    <span class="eyebrow__label">Observability</span>
    <span class="eyebrow__sep">/</span>
    <span>AI interview telemetry</span>
  </p>
  <h1 class="page-title reveal" data-delay="1">The engineering, shown in the open.</h1>
  <p class="page-subtitle reveal" data-delay="2">
    Live aggregates from the AI interview behind this site: eval pass-rates, cost, latency, and
    guardrail catches. No transcripts, no visitor data — every number traces to a committed eval
    run or the local telemetry table.
  </p>
  <p class="lab-meta reveal" data-delay="3">
    <% if (run) { %>
      <span class="badge <%= lab.stale ? 'badge--pending' : 'badge--active' %>"><span class="badge__dot"></span><%= lab.stale ? 'STALE' : 'LIVE' %></span>
      LAST RUN <%= run.startedAt.slice(0, 10) %> · PROMPT <span class="accent"><%= lab.latestRunLabel %></span> (<%= run.promptHash %>)
      · MODE <%= run.mode.toUpperCase() %><%= run.mode === 'offline' ? ' (stub model + heuristic judge — plumbing quality, not model quality)' : '' %>
    <% } else { %>
      NO PUBLISHED EVAL RUNS YET — run <code>npm run eval</code> and commit the result.
    <% } %>
  </p>
</section>

<section class="section" aria-labelledby="lab-signals">
  <header class="section__head reveal">
    <h2 class="section__title" id="lab-signals"><span class="section__index">§01</span> Signals</h2>
    <span class="section__action">Last <%= t.windowDays %> days of chat · all published runs</span>
  </header>
  <div class="stat-cards">
    <div class="stat-card stat-card--accent reveal">
      <span class="stat-card__value"><%= run ? fmtPct(run.passRate) : '—' %></span>
      <span class="stat-card__label">Eval pass rate</span>
      <span class="stat-card__sub"><%= run ? `${run.passed}/${run.total} cases · gate ${run.gatePassed ? 'PASS' : 'FAIL'}` : 'no runs published' %></span>
      <span class="stat-card__src">eval_runs.pass_rate</span>
    </div>
    <div class="stat-card reveal" data-delay="1">
      <span class="stat-card__value"><%= fmtUsd(t.costPerConversation) %></span>
      <span class="stat-card__label">Cost / conversation</span>
      <span class="stat-card__sub"><%= t.turnCount ? `${t.turnCount} traced turns` : 'no live traffic traced yet' %></span>
      <span class="stat-card__src">traces.est_cost_usd</span>
    </div>
    <div class="stat-card reveal" data-delay="2">
      <span class="stat-card__value"><%= fmtMs(t.latencyP95) %></span>
      <span class="stat-card__label">P95 latency</span>
      <span class="stat-card__sub"><%= t.latencyP50 === null ? 'no live traffic traced yet' : `p50 ${fmtMs(t.latencyP50)}` %></span>
      <span class="stat-card__src">traces.latency_ms</span>
    </div>
    <div class="stat-card reveal" data-delay="3">
      <span class="stat-card__value"><%= t.turnCount ? t.guardrailFlaggedCount : '—' %></span>
      <span class="stat-card__label">Guardrail catches</span>
      <span class="stat-card__sub"><%= t.turnCount ? `${t.refusedCount} refusals in window` : 'no live traffic traced yet' %></span>
      <span class="stat-card__src">traces.guardrail_flags</span>
    </div>
    <div class="stat-card reveal" data-delay="4">
      <span class="stat-card__value"><%= fmtPct(t.cacheHitRate) %></span>
      <span class="stat-card__label">Cache hit rate</span>
      <span class="stat-card__sub"><%= t.cacheHitRate === null ? (t.firstTraceAt ? `since ${t.firstTraceAt.slice(0,10)}` : 'no live traffic traced yet') : 'prompt-cache reads ÷ input tokens' %></span>
      <span class="stat-card__src">traces.cache_read_tokens</span>
    </div>
  </div>
</section>

<% if (lab.runSeries.length > 0) { %>
<section class="section" aria-labelledby="lab-trend">
  <header class="section__head reveal">
    <h2 class="section__title" id="lab-trend"><span class="section__index">§02</span> Pass rate over runs</h2>
    <span class="section__action">Target ≥ <%= run ? Math.round(run.threshold * 100) : 90 %> per category</span>
  </header>
  <figure class="ascii-chart reveal" role="img" aria-label="Eval pass rate across published runs">
    <div data-chart='<%- JSON.stringify(lab.runSeries.map(r => ({ x: r.x, label: r.label, v: r.v }))) %>' data-target="<%= run ? Math.round(run.threshold * 100) : 90 %>"></div>
    <table class="sr-only">
      <caption>Eval pass rate by run</caption>
      <thead><tr><th scope="col">Run date</th><th scope="col">Prompt</th><th scope="col">Mode</th><th scope="col">Pass rate</th></tr></thead>
      <tbody>
        <% lab.runSeries.forEach((r) => { %>
          <tr><td><%= r.x %></td><td><%= r.label %></td><td><%= r.mode %></td><td><%= r.v %>%</td></tr>
        <% }) %>
      </tbody>
    </table>
  </figure>
</section>
<% } %>

<section class="section" aria-labelledby="lab-cats">
  <div class="lab-grid">
    <div>
      <header class="section__head reveal">
        <h2 class="section__title" id="lab-cats"><span class="section__index">§03</span> By category</h2>
      </header>
      <% if (run) { %>
        <% run.byCategory.forEach((c) => { %>
          <div class="meter <%= c.category === 'safety' ? 'meter--accent' : '' %>" role="meter" aria-valuenow="<%= Math.round(c.passRate * 100) %>" aria-valuemin="0" aria-valuemax="100" aria-label="<%= c.category %> pass rate">
            <span class="meter__label"><%= c.category %></span>
            <span class="meter__track"><span class="meter__fill" data-pct="<%= Math.round(c.passRate * 100) %>"></span></span>
            <span class="meter__val"><%= Math.round(c.passRate * 100) %></span>
          </div>
        <% }) %>
        <p class="lab-foot">pass ≥ <%= Math.round(run.threshold * 100) %> required per category for the CI gate.</p>
      <% } else { %>
        <p class="empty">No published runs yet.</p>
      <% } %>
    </div>
    <div>
      <header class="section__head reveal">
        <h2 class="section__title"><span class="section__index">§04</span> Routing mix</h2>
      </header>
      <% if (t.routingMix.length > 0) { %>
        <% const totalTurns = t.routingMix.reduce((s, m) => s + m.turns, 0); %>
        <% t.routingMix.forEach((m) => { %>
          <div class="meter <%= m.tier === 'sonnet' ? 'meter--accent' : '' %>" role="meter" aria-valuenow="<%= Math.round((m.turns / totalTurns) * 100) %>" aria-valuemin="0" aria-valuemax="100" aria-label="<%= m.tier %> share of turns">
            <span class="meter__label"><%= m.tier %></span>
            <span class="meter__track"><span class="meter__fill" data-pct="<%= Math.round((m.turns / totalTurns) * 100) %>"></span></span>
            <span class="meter__val"><%= m.turns %></span>
          </div>
        <% }) %>
      <% } else { %>
        <p class="empty">No traced turns yet.</p>
      <% } %>
      <p class="lab-foot">ROUTER: <%= t.routerEnabled ? 'ON (Haiku → Sonnet escalation)' : 'OFF (flagged; all turns on the cheap tier by design)' %></p>
    </div>
  </div>
</section>

<section class="section" aria-labelledby="lab-versions">
  <header class="section__head reveal">
    <h2 class="section__title" id="lab-versions"><span class="section__index">§05</span> Prompt versions</h2>
  </header>
  <% lab.promptVersions.forEach((v, i) => { %>
    <div class="version-row <%= i === 0 ? 'version-row--accent' : '' %> reveal">
      <span class="version-row__dot" aria-hidden="true"></span>
      <div class="version-row__head">
        <span class="version-row__v"><%= v.version %> ‹<%= v.hash %>›</span>
        <span class="version-row__date"><%= v.date %></span>
      </div>
      <p class="version-row__body"><%= v.note %></p>
    </div>
  <% }) %>
</section>

<section class="section">
  <p class="lab-foot reveal">
    METHOD — golden set of <%= run ? run.total : 18 %> cases (factual · tone · scope · safety) run
    through the same guardrail pipeline production uses; verdicts by
    <%= run && run.mode === 'live' ? 'an LLM judge with a typed rubric' : 'a deterministic offline judge (refusal detection)' %>.
    Publishing = committing the run file. Sessions to date: <%= lab.totals.sessionCount %> ·
    lifetime tokens: <%= lab.totals.inputTokens.toLocaleString() %> in / <%= lab.totals.outputTokens.toLocaleString() %> out.
  </p>
  <div class="hero__actions reveal" data-delay="1">
    <a href="/lab/red-team" class="btn btn--accent btn--block">The red-team log: breaking my own AI, in public <span class="btn__arrow" aria-hidden="true">→</span></a>
  </div>
</section>

<%- include('../../partials/footer') %>
