<%- include('../partials/head', { nav: 'admin', bodyClass: 'page-admin' }) %>

<section class="admin">
  <header class="admin__head admin__head--row">
    <div>
      <h1 class="admin__title">Skills</h1>
      <p class="admin__subtitle"><%= skillGroups.length %> categories</p>
    </div>
    <a class="btn btn--accent" href="/admin/skills/new">+ New skill</a>
  </header>

  <% if (skillGroups.length === 0) { %>
    <p class="empty">No skills yet. <a href="/admin/skills/new">Add one</a>.</p>
  <% } else { %>
    <% skillGroups.forEach(function (group) { %>
      <section class="admin__panel">
        <div class="admin__panel-head">
          <h2 class="admin__panel-title"><%= group.category %></h2>
        </div>
        <ul class="skill-admin-list">
          <% group.skills.forEach(function (skill) { %>
            <li class="skill-admin-list__item">
              <span class="skill-admin-list__name"><%= skill.name %></span>
              <span class="row-actions">
                <a class="btn btn--ghost btn--sm" href="/admin/skills/<%= skill.id %>/edit">Edit</a>
                <form class="inline-form" method="post" action="/admin/skills/<%= skill.id %>/delete" data-confirm="Delete “<%= skill.name %>”?">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                  <button class="btn btn--danger btn--sm" type="submit">Delete</button>
                </form>
              </span>
            </li>
          <% }); %>
        </ul>
      </section>
    <% }); %>
  <% } %>
</section>

<%- include('../partials/footer') %>
