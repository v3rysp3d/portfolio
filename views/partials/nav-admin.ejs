<header class="topbar topbar--admin">
  <div class="topbar__inner">
    <a class="monogram" href="/admin" aria-label="Admin home">
      <span class="monogram__mark"><%= helpers.initials(profile.name) %></span>
      <span class="monogram__name">Admin<span class="monogram__sub"> · <%= profile.name %></span></span>
    </a>

    <nav class="topnav" aria-label="Admin">
      <a href="/admin" class="topnav__link <%= currentPath === '/admin' ? 'is-active' : '' %>">Dashboard</a>
      <a href="/admin/projects" class="topnav__link <%= currentPath.indexOf('/admin/projects') === 0 ? 'is-active' : '' %>">Projects</a>
      <a href="/admin/experience" class="topnav__link <%= currentPath.indexOf('/admin/experience') === 0 ? 'is-active' : '' %>">Experience</a>
      <a href="/admin/skills" class="topnav__link <%= currentPath.indexOf('/admin/skills') === 0 ? 'is-active' : '' %>">Skills</a>
      <a href="/admin/interviews" class="topnav__link <%= currentPath.indexOf('/admin/interviews') === 0 ? 'is-active' : '' %>">Interviews</a>
      <a href="/admin/profile" class="topnav__link <%= currentPath.indexOf('/admin/profile') === 0 ? 'is-active' : '' %>">Profile</a>
      <a href="/admin/account" class="topnav__link <%= currentPath.indexOf('/admin/account') === 0 ? 'is-active' : '' %>">Account</a>
      <a href="/" class="topnav__link" target="_blank" rel="noopener">View site ↗</a>
    </nav>

    <form action="/admin/logout" method="post" class="logout-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <button type="submit" class="btn btn--ghost btn--sm">Sign out</button>
    </form>

    <button class="nav-toggle" type="button" aria-label="Toggle menu" aria-expanded="false" data-nav-toggle>
      <span></span><span></span>
    </button>
  </div>
</header>
